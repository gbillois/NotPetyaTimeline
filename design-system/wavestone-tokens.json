{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Wavestone Design System — tokens distilled from the Wavestone Universal Registration Document 2024/25. W3C Design Tokens Community Group format. Importable into Tokens Studio for Figma, Style Dictionary, and similar tooling.",
  "color": {
    "$type": "color",
    "indigo": {
      "50":  { "$value": "#F1EEFB" },
      "100": { "$value": "#D1CAF2" },
      "200": { "$value": "#BDAFEB" },
      "300": { "$value": "#A18FE3" },
      "400": { "$value": "#866CDB" },
      "500": { "$value": "#5A2BE0" },
      "600": { "$value": "#451DC7", "$description": "Wavestone primary brand color" },
      "700": { "$value": "#36169B" },
      "800": { "$value": "#2D1380" },
      "900": { "$value": "#1E0D57" },
      "950": { "$value": "#150939" }
    },
    "green": {
      "50":  { "$value": "#E1FDED" },
      "100": { "$value": "#C8FBDC" },
      "200": { "$value": "#A6FACA" },
      "300": { "$value": "#5CF59E" },
      "400": { "$value": "#04F06A", "$description": "Wavestone accent (neon). Use on dark surfaces or at large sizes." },
      "500": { "$value": "#06D964" },
      "600": { "$value": "#06B854" },
      "700": { "$value": "#088A42", "$description": "Accessible green text on white" },
      "800": { "$value": "#066632" }
    },
    "teal": {
      "300": { "$value": "#6EC3C9" },
      "400": { "$value": "#3E9BA3" },
      "500": { "$value": "#228D95" },
      "600": { "$value": "#1E7A82" },
      "700": { "$value": "#18636A" }
    },
    "ink": {
      "0":   { "$value": "#FFFFFF" },
      "50":  { "$value": "#F5F4F9" },
      "100": { "$value": "#E6E4EE" },
      "200": { "$value": "#CFCCDC" },
      "300": { "$value": "#A8A4B8" },
      "400": { "$value": "#817C95" },
      "500": { "$value": "#6B6580" },
      "600": { "$value": "#514C63" },
      "700": { "$value": "#3A3550" },
      "800": { "$value": "#242036" },
      "900": { "$value": "#16121F" }
    },
    "status": {
      "success": { "$value": "#088A42" },
      "warning": { "$value": "#C8861A" },
      "danger":  { "$value": "#D8412F" },
      "info":    { "$value": "#228D95" }
    },
    "semantic": {
      "$description": "Role-based aliases. Reference these from components.",
      "bg":              { "$value": "{color.ink.0}" },
      "bg-subtle":       { "$value": "{color.ink.50}" },
      "bg-muted":        { "$value": "{color.ink.100}" },
      "bg-inverse":      { "$value": "{color.indigo.800}" },
      "surface":         { "$value": "{color.ink.0}" },
      "text":            { "$value": "{color.ink.900}" },
      "text-muted":      { "$value": "{color.ink.500}" },
      "text-subtle":     { "$value": "{color.ink.400}" },
      "text-inverse":    { "$value": "{color.ink.0}" },
      "heading":         { "$value": "{color.indigo.600}" },
      "primary":         { "$value": "{color.indigo.600}" },
      "primary-hover":   { "$value": "{color.indigo.700}" },
      "primary-active":  { "$value": "{color.indigo.800}" },
      "primary-subtle":  { "$value": "{color.indigo.50}" },
      "primary-contrast":{ "$value": "{color.ink.0}" },
      "accent":          { "$value": "{color.green.400}" },
      "accent-strong":   { "$value": "{color.green.700}" },
      "accent-subtle":   { "$value": "{color.green.50}" },
      "accent-contrast": { "$value": "{color.indigo.900}" },
      "secondary":       { "$value": "{color.teal.500}" },
      "border":          { "$value": "{color.ink.100}" },
      "border-strong":   { "$value": "{color.ink.200}" },
      "focus-ring":      { "$value": "{color.indigo.500}" }
    }
  },
  "gradient": {
    "$type": "gradient",
    "brand": {
      "$value": [
        { "color": "#5226E0", "position": 0 },
        { "color": "#451DC7", "position": 0.38 },
        { "color": "#2D1380", "position": 1 }
      ],
      "$description": "Signature cover gradient. CSS: radial-gradient(120% 120% at 25% 15%, #5226E0 0%, #451DC7 38%, #2D1380 100%)"
    },
    "accent": {
      "$value": [
        { "color": "#04F06A", "position": 0 },
        { "color": "#5CF59E", "position": 1 }
      ]
    }
  },
  "fontFamily": {
    "$type": "fontFamily",
    "display": { "$value": ["Poppins", "Montserrat", "system-ui", "sans-serif"], "$description": "Geometric display face; substitute the licensed Wavestone typeface in production." },
    "body":    { "$value": ["Inter", "system-ui", "-apple-system", "Segoe UI", "Roboto", "sans-serif"] },
    "mono":    { "$value": ["IBM Plex Mono", "ui-monospace", "SF Mono", "Menlo", "monospace"] }
  },
  "fontWeight": {
    "$type": "fontWeight",
    "regular":   { "$value": 400 },
    "medium":    { "$value": 500 },
    "semibold":  { "$value": 600 },
    "bold":      { "$value": 700 },
    "extrabold": { "$value": 800 }
  },
  "fontSize": {
    "$type": "dimension",
    "xs":   { "$value": "12px" },
    "sm":   { "$value": "14px" },
    "base": { "$value": "16px" },
    "lg":   { "$value": "18px" },
    "xl":   { "$value": "20px" },
    "2xl":  { "$value": "24px" },
    "3xl":  { "$value": "30px" },
    "4xl":  { "$value": "36px" },
    "5xl":  { "$value": "48px" },
    "6xl":  { "$value": "60px" },
    "7xl":  { "$value": "72px" }
  },
  "lineHeight": {
    "$type": "number",
    "none":    { "$value": 1 },
    "tight":   { "$value": 1.15 },
    "snug":    { "$value": 1.3 },
    "normal":  { "$value": 1.5 },
    "relaxed": { "$value": 1.65 }
  },
  "letterSpacing": {
    "$type": "dimension",
    "tighter": { "$value": "-0.03em" },
    "tight":   { "$value": "-0.015em" },
    "normal":  { "$value": "0em" },
    "wide":    { "$value": "0.04em" },
    "eyebrow": { "$value": "0.14em" }
  },
  "spacing": {
    "$type": "dimension",
    "0":  { "$value": "0px" },
    "1":  { "$value": "4px" },
    "2":  { "$value": "8px" },
    "3":  { "$value": "12px" },
    "4":  { "$value": "16px" },
    "5":  { "$value": "20px" },
    "6":  { "$value": "24px" },
    "8":  { "$value": "32px" },
    "10": { "$value": "40px" },
    "12": { "$value": "48px" },
    "16": { "$value": "64px" },
    "20": { "$value": "80px" },
    "24": { "$value": "96px" },
    "32": { "$value": "128px" }
  },
  "radius": {
    "$type": "dimension",
    "none": { "$value": "0px" },
    "sm":   { "$value": "4px" },
    "md":   { "$value": "8px" },
    "lg":   { "$value": "12px" },
    "xl":   { "$value": "16px" },
    "2xl":  { "$value": "24px" },
    "3xl":  { "$value": "32px" },
    "pill": { "$value": "999px" }
  },
  "borderWidth": {
    "$type": "dimension",
    "default": { "$value": "1px" },
    "thick":   { "$value": "2px" },
    "heavy":   { "$value": "4px" }
  },
  "shadow": {
    "$type": "shadow",
    "xs": { "$value": { "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px", "color": "rgba(22,18,31,0.06)" } },
    "sm": { "$value": { "offsetX": "0px", "offsetY": "1px", "blur": "3px", "spread": "0px", "color": "rgba(22,18,31,0.08)" } },
    "md": { "$value": { "offsetX": "0px", "offsetY": "4px", "blur": "12px", "spread": "0px", "color": "rgba(22,18,31,0.10)" } },
    "lg": { "$value": { "offsetX": "0px", "offsetY": "12px", "blur": "28px", "spread": "0px", "color": "rgba(22,18,31,0.12)" } },
    "xl": { "$value": { "offsetX": "0px", "offsetY": "24px", "blur": "48px", "spread": "0px", "color": "rgba(22,18,31,0.16)" } },
    "brand": { "$value": { "offsetX": "0px", "offsetY": "14px", "blur": "30px", "spread": "0px", "color": "rgba(69,29,199,0.30)" } }
  },
  "duration": {
    "$type": "duration",
    "fast": { "$value": "120ms" },
    "base": { "$value": "200ms" },
    "slow": { "$value": "320ms" }
  },
  "cubicBezier": {
    "$type": "cubicBezier",
    "standard":   { "$value": [0.2, 0, 0, 1] },
    "in":         { "$value": [0.4, 0, 1, 1] },
    "out":        { "$value": [0, 0, 0.2, 1] },
    "emphasized": { "$value": [0.2, 0, 0, 1.2] }
  },
  "breakpoint": {
    "$type": "dimension",
    "sm":  { "$value": "640px" },
    "md":  { "$value": "768px" },
    "lg":  { "$value": "1024px" },
    "xl":  { "$value": "1280px" },
    "2xl": { "$value": "1440px" }
  }
}
